    <div class="invoice-title"><div class="label">Documento</div><h3>FACTURA</h3><span class="status">PAGO PENDIENTE · CITA NO CONFIRMADA</span></div>
  </div>
  <div class="invoice-meta">
    <div class="meta-box"><small>Confirmación de cita / referencia</small><strong>${invoiceNo}</strong></div>
