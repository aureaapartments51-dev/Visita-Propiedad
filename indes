.invoice{margin-top:22px;border:1px solid #e1e4e8;border-radius:28px;overflow:hidden;background:#fff;box-shadow:0 22px 60px rgba(0,0,0,.07)}
.invoice-head{display:flex;justify-content:space-between;gap:24px;padding:26px;background:#090a0d;color:#fff;border-bottom:0}
.invoice-brand{display:flex;gap:12px;align-items:center}.invoice-brand img{width:45px;height:45px;border-radius:14px;object-fit:cover;border:1px solid #c9a45d}.invoice-brand strong{display:block;font-size:14px}.invoice-brand span{display:block;color:#aeb3bb;font-size:10px;margin-top:3px}
.invoice-title{text-align:right}.invoice-title .label{font-size:9px;font-weight:850;letter-spacing:.15em;color:#9ea3aa;text-transform:uppercase}.invoice-title h3{font-size:25px;letter-spacing:-.04em;margin:4px 0 6px}.invoice-title .status{display:inline-block;padding:6px 10px;border-radius:100px;background:#fff;color:#090a0d;font-size:9px;font-weight:900}
.invoice-meta{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#e7e9ed;border-bottom:0}
.meta-box{padding:19px 22px;background:#fafbfc}.meta-box small{display:block;color:#858a92;font-size:8px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:6px}.meta-box strong{font-size:12px;line-height:1.45}
.invoice-table{padding:0 22px}.invoice-table .thead,.invoice-table .item{display:grid;grid-template-columns:1fr 120px 120px;gap:12px;align-items:center}.invoice-table .thead{padding:12px 0;border-bottom:1px solid #ddd;color:#8a8f97;font-size:8px;text-transform:uppercase;letter-spacing:.1em;font-weight:900}.invoice-table .item{padding:16px 0;border-bottom:1px solid #eee;font-size:11px}.invoice-table .item .desc strong{display:block;font-size:13px}.invoice-table .item .desc span{display:block;color:#777;font-size:9px;margin-top:4px}.invoice-table .num{text-align:right}
.invoice-totals{margin-left:auto;width:min(330px,100%);padding:12px 22px 20px}.total-row{display:flex;justify-content:space-between;padding:7px 0;font-size:11px}.total-row.grand{margin-top:7px;padding-top:12px;border-top:1px solid #ccc;font-size:15px;font-weight:900}.total-row.grand strong{font-size:20px}
.invoice-foot{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:18px 22px;background:#fafbfc;border-top:1px solid #e7e9ed}.invoice-foot small{color:#858a92;font-size:8px;text-transform:uppercase;letter-spacing:.1em;font-weight:900}.invoice-foot p{margin:5px 0 0;color:#555;font-size:9px;line-height:1.5}.invoice-note{margin:14px 22px 20px;padding:12px 14px;border-left:2px solid #090a0d;background:#f4f5f7;color:#555;font-size:9px;line-height:1.5}

.action-box{display:flex;gap:13px;align-items:flex-start;margin-top:12px;padding:15px 16px;border:1px solid #e1e4e8;border-radius:17px;background:#fafbfc}.action-icon{width:28px;height:28px;min-width:28px;border-radius:50%;background:#090a0d;color:#fff;display:grid;place-items:center;font-size:11px;font-weight:900}.action-box strong{font-size:12px}.action-box p{margin:4px 0 0;color:#6b7078;font-size:10px;line-height:1.45}.contact-box{margin-top:18px;padding:18px;border-radius:20px;background:#090a0d;color:#fff}.contact-box>strong{font-size:13px}.contact-box p{margin:8px 0 14px;color:#d2d5da;font-size:11px;line-height:1.5}.contact-actions{display:flex;gap:9px}.contact-actions .primary{background:#fff;color:#090a0d;box-shadow:none}.wa-btn{display:flex;align-items:center;justify-content:center;flex:1;background:#fff;color:#090a0d;border-radius:16px;padding:15px 19px;font-size:13px;font-weight:850;text-decoration:none}.contact-actions button{flex:1}

.payment-status{margin-top:20px;padding:20px;border-radius:20px;background:#090a0d;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:14px}
.payment-status small{display:block;color:#b8bcc3;font-size:9px;letter-spacing:.12em;font-weight:900}
.payment-status strong{display:block;font-size:32px;letter-spacing:-.04em;margin-top:3px}
.payment-status>span{font-size:10px;font-weight:900;background:#fff;color:#090a0d;padding:8px 10px;border-radius:100px;white-space:nowrap}
.wa-main{font-weight:900;min-height:50px;display:flex;align-items:center;justify-content:center;text-decoration:none;text-align:center}
.small-note{text-align:center;color:#858a92;font-size:9px;line-height:1.5;margin:14px 4px 0}

@media(max-width:520px){
 .app{padding:18px 12px 38px}.card{padding:21px;border-radius:24px}.brand h1{font-size:16px}.header .badge{display:none}h2{font-size:29px}
 .payment-grid{grid-template-columns:1fr}.actions{flex-direction:column-reverse}.actions .secondary{width:100%}
 .invoice-head{padding:19px 16px}.invoice-title h3{font-size:20px}.meta-box{padding:15px 16px}.invoice-table{padding:0 16px}.invoice-table .thead,.invoice-table .item{grid-template-columns:1fr 70px 82px;gap:8px}.invoice-totals{padding:10px 16px 16px}.invoice-foot{grid-template-columns:1fr;padding:15px 16px}.contact-actions{flex-direction:column}.invoice-note{margin:12px 16px 16px}
}
@media print{
 body{background:#fff}.app{width:100%;padding:0}.header,.progress,form,footer,#printBtn,#newBtn,.capture,.print-hide{display:none!important}.card{border:0;box-shadow:none;padding:0}.step#step4{display:block!important}.invoice{border:1px solid #ccc;box-shadow:none;border-radius:0}
}
</style>

</head><body>
<main class="app">
<header class="header">
  <div class="brand"><img class="logo-img" src="data:image/jpeg;base64," alt="Aurea Apartments"><div><h1>Visita de propiedad</h1><p>Reserva y confirma tu cita en pocos pasos.</p></div></div>
  <div class="badge">V4 · DEMO</div>
</header>
<div class="trust"><span>✓ Información clara</span><span>✓ Depósito indicado antes del pago</span><span>✓ Confirmación por escrito</span></div>
<div class="progress"><span class="dot active">1</span><span class="bar"></span><span class="dot">2</span><span class="bar"></span><span class="dot">3</span><span class="bar"></span><span class="dot">4</span></div>

<form id="form">
<section class="card step active" data-step="1">
  <div class="eyebrow">Paso 1 de 4</div><h2>Programa tu visita</h2><p class="sub">Elige la propiedad, el día y el horario que deseas visitar.</p>
  <label>Dirección de la propiedad<input id="property" required placeholder="Ej. 123 Main Street, Apt. 4B"></label>
  <label>Fecha de visita<input id="date" type="date" required></label>
  <label>Horario<select id="time" required><option value="">Selecciona un horario</option>
    <option>9:00 AM</option><option>10:00 AM</option><option>11:00 AM</option><option>12:00 PM</option>
    <option>1:00 PM</option><option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option>
    <option>5:00 PM</option><option>6:00 PM</option><option>7:00 PM</option><option>8:00 PM</option>
  </select></label>
  <div class="actions"><button type="button" class="primary next" data-next="2">Continuar</button></div>
</section>

<section class="card step" data-step="2">
  <div class="eyebrow">Paso 2 de 4</div><h2>Información del cliente</h2><p class="sub">Completa tus datos para identificar la solicitud de visita.</p>
  <label>Nombre completo<input id="name" required placeholder="Nombre y apellido"></label>
  <label>Teléfono / WhatsApp<input id="phone" required placeholder="+1 000 000 0000"></label>
  <label>Correo electrónico<input id="email" type="email" required placeholder="correo@ejemplo.com"></label>
  <label>¿Tienes mascotas?<select id="pets" required><option value="">Selecciona</option><option>No</option><option>Sí</option></select></label>
  <div class="actions"><button type="button" class="secondary back">Atrás</button><button type="button" class="primary next" data-next="3">Continuar</button></div>
</section>

<section class="card step" data-step="3">
  <div class="eyebrow">Paso 3 de 4</div><h2>Depósito de confirmación</h2><p class="sub">Revisa tu solicitud y elige el método que prefieres utilizar para completar el pago después de enviar la solicitud.</p>
  <div class="summary" id="summary"></div>
  <div class="amount"><div><strong>$170</strong><small>Depósito de confirmación</small></div><div>REEMBOLSABLE</div></div>
  <div class="notice"><strong>¿Qué ocurre con los $170?</strong><br>
  El depósito de confirmación es de <strong>$170</strong>. Después de enviar esta solicitud, deberás comunicarte con nosotros para completar el pago. La cita queda pendiente hasta que el pago sea recibido y verificado. Si decides no continuar con el proceso de alquiler, los <strong>$170 serán reembolsados</strong>. Si decides continuar, los <strong>$170 se agregarán al depósito del primer mes de renta</strong>.</div>
  <div class="notice"><strong>Importante:</strong> aquí no se realiza ningún cobro. Primero completas y envías tu solicitud; después te comunicas con nosotros para completar el pago de $170 y recibir la confirmación definitiva de la cita.</div>
  <div class="eyebrow" style="margin-top:22px">Método para realizar el depósito</div><p class="sub">Selecciona el método que prefieres utilizar cuando te comuniques con nosotros para completar el pago.</p>
  
<div class="payment-grid">
  <div class="pay"><input id="p_zelle" name="payment" type="radio" value="Zelle" required><label for="p_zelle"><span class="pay-title">Zelle</span><span class="pay-desc">Pago electrónico mediante Zelle.</span></label></div>
  <div class="pay"><input id="p_711" name="payment" type="radio" value="7-Eleven"><label for="p_711"><span class="pay-title">7-Eleven</span><span class="pay-desc">Realiza el depósito en una tienda participante.</span></label></div>
  <div class="pay"><input id="p_walgreens" name="payment" type="radio" value="Walgreens"><label for="p_walgreens"><span class="pay-title">Walgreens</span><span class="pay-desc">Realiza el depósito en la farmacia.</span></label></div>
  <div class="pay"><input id="p_cvs" name="payment" type="radio" value="CVS"><label for="p_cvs"><span class="pay-title">CVS</span><span class="pay-desc">Realiza el depósito en la farmacia.</span></label></div>
  <div class="pay"><input id="p_family" name="payment" type="radio" value="Family Dollar"><label for="p_family"><span class="pay-title">Family Dollar</span><span class="pay-desc">Realiza el depósito en la tienda.</span></label></div>
  <div class="pay"><input id="p_general" name="payment" type="radio" value="Dollar General"><label for="p_general"><span class="pay-title">Dollar General</span><span class="pay-desc">Realiza el depósito en la tienda.</span></label></div>
  <div class="pay"><input id="p_tree" name="payment" type="radio" value="Dollar Tree"><label for="p_tree"><span class="pay-title">Dollar Tree</span><span class="pay-desc">Realiza el depósito en la tienda.</span></label></div>
</div>

  <label class="check"><input id="terms" type="checkbox" required><span>Confirmo que revisé la información de la solicitud y del depósito de $170 y deseo enviar mi solicitud de visita. Entiendo que la cita no queda confirmada hasta completar y verificar el pago.</span></label>
  <div class="actions"><button type="button" class="secondary back">Atrás</button><button type="submit" class="primary" id="submitBtn">Enviar solicitud de visita</button></div><p id="emailStatus" style="display:none;margin:10px 0 0;color:#b42318;font-size:11px;line-height:1.45"></p>
</section>
</form>

<section class="card step" id="step4" data-step="4">
  <div class="success"><div class="success-icon">✓</div><div class="eyebrow">Solicitud recibida</div><h2>Tu visita está lista para ser confirmada</h2><p class="sub">Completaste tu solicitud correctamente. Falta el último paso: completar el depósito de $170 para confirmar tu horario.</p><span class="ref" id="ref"></span></div>
<div class="payment-status"><div><small>DEPÓSITO DE CONFIRMACIÓN</small><strong>$170.00</strong></div><span>🟡 PAGO PENDIENTE</span></div>
<div class="summary" id="finalSummary"></div>
  <div class="action-box">
    <div class="action-icon">1</div><div><strong>Completa el depósito de $170</strong><p>Contacta al asesor para recibir las instrucciones del método de pago seleccionado.</p></div>
  </div>
  <div class="action-box">
    <div class="action-icon">2</div><div><strong>Envía tu referencia</strong><p>Tu referencia identifica tu solicitud y permite localizar rápidamente tu visita.</p></div>
  </div>
  <div class="action-box">
    <div class="action-icon">3</div><div><strong>Recibe la confirmación</strong><p>La cita pasa a <b>CONFIRMADA</b> después de recibir y verificar el depósito.</p></div>
  </div>
  <div class="contact-box"><strong>Mensaje listo para enviar</strong><p id="contactMessage"></p><div class="contact-actions"><a class="wa-btn wa-main" id="waBtn" target="_blank" rel="noopener">📲 COMPLETAR MI CONFIRMACIÓN POR WHATSAPP</a><button type="button" class="primary" id="copyBtn">Copiar mensaje</button></div></div>
  <div class="receipt" id="receipt"></div>
  <div class="download-box"><div style="font-size:25px">📄</div><strong>Descarga tu documento de solicitud</strong><p>Conserva este documento. Incluye tu referencia, la propiedad, la fecha, el horario y el método de pago seleccionado.</p><div class="important"><strong>Estado actual</strong><p>Pago pendiente. Este documento no demuestra que se haya realizado un pago. La cita se confirma únicamente después de completar y verificar el pago de $170. Si no continúas con el proceso de alquiler, los $170 serán reembolsados; si continúas, se agregarán al depósito del primer mes de renta.</p></div></div>
  <button type="button" class="primary" id="printBtn">Descargar documento</button>
  <button type="button" class="secondary" id="newBtn" style="width:100%;margin-top:10px">Nueva solicitud</button>
</section>
<footer>Aurea Apartments · Solicitud de visita · Pago pendiente hasta verificación</footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script>
(() => {
emailjs.init({ publicKey: "Cm_yne-Q8DMo3inGs" });
const steps=[...document.querySelectorAll(".step")], dots=[...document.querySelectorAll(".dot")], form=document.getElementById("form");let current=1;
