.card{
 background:rgba(255,255,255,.96);border:1px solid #e2e4e8;border-radius:32px;
 padding:32px;box-shadow:0 30px 80px rgba(0,0,0,.09)
}
.step{display:none}.step.active{display:block}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:9px;font-weight:900;color:#858a92;margin-bottom:10px}
h2{font-size:34px;line-height:1.02;letter-spacing:-.055em;margin:0 0 9px}.sub{color:var(--muted);line-height:1.55;margin:0;font-size:13px}
label{display:block;margin-top:21px;font-size:12px;font-weight:800}
input,select{width:100%;margin-top:8px;padding:16px;border:1px solid #dfe2e6;border-radius:16px;background:#fff;font-size:16px;outline:none;transition:.2s}
input:focus,select:focus{border-color:#777;box-shadow:0 0 0 4px #f0f1f3}
.actions{display:flex;gap:10px;margin-top:25px}
button{border:0;border-radius:16px;padding:15px 19px;font-size:13px;font-weight:850;cursor:pointer}
.primary{background:#090a0d;color:#fff;flex:1;box-shadow:0 10px 25px rgba(0,0,0,.14)}.secondary{background:#eceef1;color:#090a0d}
.payment-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.pay{position:relative}.pay input{position:absolute;opacity:0}.pay label{margin:0;border:1px solid #dfe2e6;border-radius:18px;padding:17px;min-height:88px;background:#fff}.pay input:checked+label{border:2px solid #090a0d;padding:16px;background:#fafafa}
.pay-title{font-weight:850;display:block}.pay-desc{display:block;color:#777;font-size:10px;margin-top:5px;line-height:1.4}
.amount{display:flex;align-items:center;justify-content:space-between;padding:19px;border-radius:19px;background:#090a0d;color:#fff;margin-top:18px}.amount strong{font-size:26px}.amount small{display:block;color:#c8cbd0;margin-top:3px}
.notice{margin-top:14px;padding:15px;border-radius:16px;background:#f3f4f6;color:#555;font-size:11px;line-height:1.55}.notice strong{color:#090a0d}.check{display:flex;gap:10px;align-items:flex-start;margin-top:17px;font-size:11px;line-height:1.45}.check input{width:auto;margin:3px 0 0}
.summary,.receipt{margin-top:18px;border:1px solid var(--line);border-radius:18px;padding:5px 15px;background:#fff}.row{display:flex;justify-content:space-between;gap:18px;padding:13px 0;border-bottom:1px solid #eee;font-size:12px}.row:last-child{border:0}.row b{text-align:right}
.success{text-align:center;padding:10px 0 4px}.success-icon{width:70px;height:70px;border-radius:24px;background:#090a0d;color:#fff;display:grid;place-items:center;font-size:30px;margin:0 auto 17px;box-shadow:0 15px 35px rgba(0,0,0,.16)}.success h2{margin-bottom:8px}.ref{display:inline-block;background:#eff1f4;border-radius:100px;padding:8px 11px;font-size:10px;font-weight:850;margin-top:8px}
.download-box{margin-top:18px;border:1px solid #dfe3e8;border-radius:18px;padding:18px;text-align:center;background:#fafbfc}.download-box strong{display:block;margin-top:4px;font-size:13px;color:#202327}.download-box p{font-size:11px;color:#5f646b;line-height:1.5;margin:7px 0 0}.download-box .important{margin-top:14px;padding:12px 13px;border-radius:12px;background:#fff;border:1px solid #e4e7eb;text-align:left}.download-box .important strong{font-size:11px;text-transform:uppercase;letter-spacing:.04em;margin:0 0 4px}.download-box .important p{margin:0;font-size:11px;color:#3e4349}footer{text-align:center;color:#999;font-size:9px;margin-top:16px}

