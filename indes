const visitDate=new Date($("date").value+"T12:00:00");
const visitDateText=visitDate.toLocaleDateString("es-DO",{year:"numeric",month:"long",day:"numeric"});
$("ref").textContent="Comprobante "+invoiceNo;
$("receipt").innerHTML=`
<div class="invoice">
