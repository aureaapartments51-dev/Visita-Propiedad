<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="apple-mobile-web-app-capable" content="yes"><title>Solicitud de visita · Aurea Apartments</title>

<style>
*{box-sizing:border-box}
:root{
